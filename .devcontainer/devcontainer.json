{
    "name": "CODE Network Game Theory (FA26)",
    "image": "mcr.microsoft.com/devcontainers/python:1-3.14-bookworm",
    "init": true,
    "remoteUser": "vscode",
    "features": {
        "ghcr.io/devcontainers/features/uv:1": {}
    },
    "postCreateCommand": "uv sync --locked",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "google.google-antigravity"
                "anthropic.claude-code"
            ],
            "settings": {
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
                "jupyter.notebookFileRoot": "${fileDirname}"
            }
        }
    },
    "hostRequirements": {
        "cpus": 2,
        "memory": "8gb"
    }
}
