{
    "name": "NetGame",
    "image": "ghcr.io/cisgroup/NetGame",
    "init": true,
    "remoteUser": "student",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "google.google-antigravity",
                "anthropic.claude-code"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/venv/bin/python",
                "jupyter.notebookFileRoot": "${fileDirname}"
            }
        }
    },
    "postAttachCommand": "cat .devcontainer/welcome.txt || true",
    "hostRequirements": {
        "cpus": 2,
        "memory": "8gb"
    }
}
